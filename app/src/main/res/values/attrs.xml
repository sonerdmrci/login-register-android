<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CustomTextField">
        <attr name="fieldType" format="enum">
            <enum name="username" value="0" />
            <enum name="email" value="1" />
            <enum name="password" value="2" />
        </attr>
    </declare-styleable>
    <declare-styleable name="CustomButton">
        <attr name="buttonTitle" format="string"/>
        <attr name="hasBackground" format="boolean"/>
        <attr name="fontSize" format="enum">
            <enum name="BIG" value="0"/>
            <enum name="MED" value="1"/>
            <enum name="SMALL" value="2"/>
        </attr>
    </declare-styleable>
</resources>